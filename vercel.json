{
  "trailingSlash": false,
  "headers": [
    {
      "source": "/embed/q/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *"
        }
      ]
    },
    {
      "source": "/((?!embed/q/).*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/reports/marmonyx-2026.html", "destination": "/reports/marmonyx-2026.html" },
    { "source": "/reports/:path*", "destination": "/index.html" },
    {
      "source": "/((?!api|reports|src|node_modules|@vite|@react-refresh|@id|@fs|images|videos|assets|_next|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ]
}
